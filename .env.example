# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYMENT_GATEWAY_SECRET: Merchant Bearer API key for https://velapayment.vercel.app and server HMAC receipt signing.
PAYMENT_GATEWAY_SECRET=""

# VELAPAYMENT_BASE_URL: Base URL of the VelaPayment Gateway (defaults to https://velapayment.vercel.app).
VELAPAYMENT_BASE_URL="https://velapayment.vercel.app"

# CJ_API_EMAIL & CJ_API_KEY: Optional CJ Dropshipping Open API 2.0 credentials for live catalog & order sync.
CJ_API_EMAIL=""
CJ_API_KEY=""
CJ_MARKUP_PERCENT="80"

# Email Automation (Choose Resend API OR SMTP e.g. Gmail App Password for automatic order confirmation emails)
RESEND_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Vela Commerce <noreply@velacommerce.co>"

